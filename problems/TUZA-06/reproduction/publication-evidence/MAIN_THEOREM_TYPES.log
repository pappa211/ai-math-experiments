@Tuza06.five_degenerate_combined : ∀ {V : Type u_1} [inst : Fintype V] [inst_1 : DecidableEq V] {G : SimpleGraph V},
  Tuza06.Degenerate G 5 →
    Tuza.tau (Tuza.triangles G) ≤ 2 * Tuza.nu (Tuza.triangles G) ∧
      (Tuza.tau (Tuza.triangles G) = 2 * Tuza.nu (Tuza.triangles G) ↔ Tuza06.ComponentCliques G)
@Tuza06.five_degenerate_equality_decomposition : ∀ {V : Type u_1} [inst : Fintype V] [inst_1 : DecidableEq V]
  {G : SimpleGraph V},
  Tuza06.Degenerate G 5 →
    (Tuza.tau (Tuza.triangles G) = 2 * Tuza.nu (Tuza.triangles G) ↔ ∃ K, Tuza06.CliqueDecomposition G K)
@Tuza06.five_degenerate_statement : ∀ {V : Type u_1} [inst : Fintype V] [inst_1 : DecidableEq V] (G : SimpleGraph V),
  Tuza06.CombinedStatement G
'Tuza06.five_degenerate_combined' depends on axioms: [propext, Classical.choice, Quot.sound]
'Tuza06.five_degenerate_statement' depends on axioms: [propext, Classical.choice, Quot.sound]
