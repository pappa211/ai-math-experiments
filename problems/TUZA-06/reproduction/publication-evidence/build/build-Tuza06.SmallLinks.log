@Tuza06.minimal_closed_link_size : ∀ {V : Type u_1} [inst : Fintype V] [inst_1 : DecidableEq V] {G : SimpleGraph V},
  Tuza06.MinimalObstruction G → ∀ {v : V} {C : Finset V}, Tuza06.LinkClosed G v C → C.Nonempty → 5 ≤ C.card
'Tuza06.minimal_closed_link_size' depends on axioms: [propext, Classical.choice, Quot.sound]
