@Tuza06.minimal_degree_five_independent : ∀ {V : Type u_1} [inst : Fintype V] [inst_1 : DecidableEq V]
  {G : SimpleGraph V},
  Tuza06.MinimalObstruction G →
    ∀ {u v : V}, Tuza06.degreeWithin G Finset.univ u = 5 → Tuza06.degreeWithin G Finset.univ v = 5 → G.Adj u v → False
@Tuza06.minimal_degree_five_neighbors_high : ∀ {V : Type u_1} [inst : Fintype V] [inst_1 : DecidableEq V]
  {G : SimpleGraph V},
  Tuza06.MinimalObstruction G →
    ∀ {v u : V}, Tuza06.degreeWithin G Finset.univ v = 5 → G.Adj v u → 7 ≤ Tuza06.degreeWithin G Finset.univ u
'Tuza06.minimal_degree_five_neighbors_high' depends on axioms: [propext, Classical.choice, Quot.sound]
