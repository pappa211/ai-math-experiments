def Tuza.AharoniInput.{u_1} : {V : Type u_1} → [Fintype V] → [DecidableEq V] → Prop :=
fun {V} [Fintype V] [DecidableEq V] =>
  ∀ (G : SimpleGraph V), Tuza.TriangleTripartite G → Tuza.tau (Tuza.triangles G) ≤ 2 * Tuza.nu (Tuza.triangles G)
def Tuza.HNSInput.{u_1} : {V : Type u_1} → [Fintype V] → [DecidableEq V] → Prop :=
fun {V} [Fintype V] [DecidableEq V] =>
  ∀ (G : SimpleGraph V),
    Tuza.TriangleTripartite G →
      Tuza.tau (Tuza.triangles G) = 2 * Tuza.nu (Tuza.triangles G) →
        ∃ K, (∀ k ∈ K, G.IsNClique 4 k) ∧ Tuza.Independent K ∧ K.card = Tuza.nu (Tuza.triangles G)
def Tuza.OCTAtMostFour.{u_1} : {V : Type u_1} → SimpleGraph V → Prop :=
fun {V} G => ∃ S, S.card ≤ 4 ∧ (SimpleGraph.induce (↑S)ᶜ G).Colorable 2
