/-- A 660-position suffix already exceeds the candidate exponent by 530. -/
theorem representative_suffix_digitSum :
    digitSum ((10001 : ℕ) ^ 2500 % 10 ^ 660) = 3030 := by
  rw [representative_modular_power]
  decide

/-- This representative passes the exact decimal-length filter. -/
theorem representative_power_digitCount :
    digitCount ((10001 : ℕ) ^ 2500) = 10001 := by
  have hk : survivorK 0 = 10001 := by decide
  have hs : survivorS 0 = 2500 := by decide
  have h := survivor_length 0
  rwa [hk, hs] at h

/-- Nevertheless its decimal suffix alone excludes it as a fixed point. -/
theorem representative_power_not_fixed : a ((10001 : ℕ) ^ 2500) ≠ 10001 ^ 2500 := by
  apply not_fixed_of_suffix_excess (m := 660) (by decide) representative_power_digitCount
  rw [representative_suffix_digitSum]
  decide

