import A113010.BlockWeights
import A113010.FilterSurvivors

/-!
Exact suffix certificates for digit-sum exclusions. Decimal truncation cannot
increase digit sum, so an excessive suffix already excludes a candidate.
The representative certificate uses repeated squaring with ordinary kernel
checked numeral equalities. It does not evaluate the entire 10001-digit power.
This module does not prove either frozen A113010 target.
-/
namespace OeisA113010

/-- Splitting a natural number at any decimal position splits its digit sum. -/
theorem digitSum_div_mod_ten_pow (n m : ℕ) :
    digitSum n = digitSum (n / 10 ^ m) + digitSum (n % 10 ^ m) := by
  have hpos : 0 < 10 ^ m := Nat.pow_pos (by decide)
  have hsplit : n / 10 ^ m * 10 ^ m + n % 10 ^ m = n := by
    have h := Nat.mod_add_div n (10 ^ m)
    simpa [Nat.mul_comm, Nat.add_comm] using h
  have h := digitSum_decimal_block (x := n / 10 ^ m) (Nat.mod_lt n hpos)
  rwa [hsplit] at h

/-- A decimal suffix has at most the digit sum of the whole number. -/
theorem digitSum_mod_ten_pow_le (n m : ℕ) :
    digitSum (n % 10 ^ m) ≤ digitSum n := by
  rw [digitSum_div_mod_ten_pow n m]
  omega

/-- An excessive suffix excludes the required digit-sum equation. -/
theorem digitSum_ne_of_suffix_excess {k s m : ℕ}
    (hs : s < digitSum (k ^ s % 10 ^ m)) : digitSum (k ^ s) ≠ s := by
  have hle := digitSum_mod_ten_pow_le (k ^ s) m
  omega

/-- If a candidate has the claimed length, an excessive suffix excludes it
as a fixed point. The base condition makes its exponent unique. -/
theorem not_fixed_of_suffix_excess {k s m : ℕ} (hk : 2 ≤ k)
    (hcount : digitCount (k ^ s) = k)
    (hs : s < digitSum (k ^ s % 10 ^ m)) : a (k ^ s) ≠ k ^ s := by
  intro hfixed
  have hp : k ^ s = k ^ digitSum (k ^ s) := by
    simpa only [hcount] using fixed_eq_pow hfixed
  have he := Nat.pow_right_injective hk hp
  exact digitSum_ne_of_suffix_excess hs he.symm

/-- Repeated-squaring step with every multiplication reduced modulo m. -/
theorem pow_mod_double {k e m r : ℕ} (h : k ^ e % m = r) :
    k ^ (2 * e) % m = (r * r) % m := by
  rw [two_mul, pow_add, Nat.mul_mod, h]

/-- The odd-exponent repeated-squaring step. -/
theorem pow_mod_double_add_one {k e m r : ℕ} (h : k ^ e % m = r) :
    k ^ (2 * e + 1) % m = ((r * r) % m * k) % m := by
  simp only [pow_succ, two_mul, pow_add, Nat.mul_mod, h, Nat.mod_mod]

set_option exponentiation.threshold 1000
set_option maxRecDepth 20000
set_option maxHeartbeats 1000000

private theorem representative_modular_power :
    (10001 : ℕ) ^ 2500 % 10 ^ 660 =  := by
  have h1 : (10001 : ℕ) ^ 1 % 10 ^ 660 = 10001 := by decide
  have h2 : (10001 : ℕ) ^ 2 % 10 ^ 660 = 100020001 := by
    have step := pow_mod_double (k := 10001) (e := 1) (m := 10 ^ 660) h1
