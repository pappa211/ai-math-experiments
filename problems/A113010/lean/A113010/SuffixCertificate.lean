    have step := pow_mod_double_add_one (k := 10001) (e := 19) (m := 10 ^ 660) h19
    have he : 2 * 19 + 1 = 39 := by decide
    rw [he] at step
    exact step.trans (by decide)
  have h78 : (10001 : ℕ) ^ 78 % 10 ^ 660 =  := by
    have step := pow_mod_double (k := 10001) (e := 39) (m := 10 ^ 660) h39
    have he : 2 * 39 = 78 := by decide
    rw [he] at step
    exact step.trans (by decide)
  have h156 : (10001 : ℕ) ^ 156 % 10 ^ 660 =  := by
